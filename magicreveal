<style>
:root{--charcoal:#2D2D2D;--yellow:#E8C547;--pink:#E89BB5;--white:#FFFFFF;--off-white:#FFFDF9;--muted:#6B7A68;}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:#1C1C1E;}
.slide{width:1080px;height:1440px;position:relative;overflow:hidden;font-family:'Poppins',sans-serif;color:var(--white);background:var(--charcoal);margin:0 auto 40px;}
.photo{position:absolute;inset:0;width:1080px;height:1440px;object-fit:cover;}
.shade{position:absolute;inset:0;background:rgba(28,28,30,.28);}
.grad-top{position:absolute;left:0;right:0;top:0;height:900px;background:linear-gradient(180deg,rgba(28,28,30,.82) 0%,rgba(28,28,30,.66) 45%,rgba(28,28,30,0) 100%);}
.grad-bottom{position:absolute;left:0;right:0;bottom:0;height:980px;background:linear-gradient(0deg,rgba(28,28,30,.86) 0%,rgba(28,28,30,.7) 45%,rgba(28,28,30,0) 100%);}
.safe{position:absolute;top:180px;right:120px;bottom:180px;left:70px;display:flex;flex-direction:column;}
.safe.top{justify-content:flex-start;}
.safe.bottom{justify-content:flex-end;}
.counter{position:absolute;top:84px;left:70px;font-family:'Poppins';font-weight:600;font-size:26px;letter-spacing:2px;color:var(--white);border:2px solid rgba(255,255,255,.75);padding:8px 24px;border-radius:40px;}
.kicker{font-family:'Poppins';font-weight:600;font-size:28px;letter-spacing:5px;text-transform:uppercase;color:var(--white);display:flex;align-items:center;gap:20px;margin-bottom:28px;}
.kicker:before{content:"";display:block;width:70px;height:6px;background:var(--yellow);border-radius:3px;}
h1,h2{font-family:'Playfair Display',serif;font-weight:700;line-height:1.12;color:var(--white);text-shadow:0 2px 18px rgba(0,0,0,.35);}
h1{font-size:80px;}
h2{font-size:68px;}
h1 em,h2 em{font-style:italic;border-bottom:7px solid var(--yellow);}
.body{font-family:'Poppins';font-weight:400;font-size:34px;line-height:1.5;margin-top:32px;color:var(--white);text-shadow:0 1px 12px rgba(0,0,0,.4);}
.body strong{font-weight:600;}
ul.list{list-style:none;margin-top:36px;}
ul.list li{font-family:'Poppins';font-size:36px;line-height:1.35;padding:14px 0 14px 54px;position:relative;border-bottom:2px solid rgba(255,255,255,.22);}
ul.list li:last-child{border-bottom:none;}
ul.list li:before{content:"";position:absolute;left:0;top:28px;width:24px;height:24px;border-radius:50%;background:var(--yellow);}
.inset{position:absolute;right:70px;bottom:150px;width:520px;border:10px solid var(--white);border-radius:24px;box-shadow:0 18px 50px rgba(0,0,0,.45);transform:rotate(-3deg);}
.inset-tag{position:absolute;right:110px;bottom:118px;background:var(--yellow);color:var(--charcoal);font-family:'Poppins';font-weight:600;font-size:26px;letter-spacing:3px;text-transform:uppercase;padding:10px 26px;border-radius:30px;transform:rotate(-3deg);}
